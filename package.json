{
  "name": "core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "test": "tsx --test tests/*.test.ts",
    "source": "node scripts/package-source.mjs",
    "predev": "npm run source",
    "prebuild": "npm run source",
    "benchmark:book": "node --import tsx scripts/benchmark-book.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-khmer": "^5.2.8",
    "@fontsource/radio-canada-big": "^5.3.0",
    "@lucide/svelte": "^1.64.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "pdfjs-dist": "^6.4.299",
    "svelte": "^5.57.3",
    "tesseract.js": "^7.0.0",
    "wasm-feature-detect": "^1.9.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@types/node": "^24.10.1",
    "autoprefixer": "^10.6.2",
    "sass": "^1.107.0",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": "26.x"
  },
  "license": "AGPL-3.0-only"
}
